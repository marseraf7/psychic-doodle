# Token lấy từ @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# ID Telegram của admin (nhiều người thì cách nhau bằng dấu phẩy). Lấy ID qua @userinfobot
ADMIN_IDS=123456789

# Tên hiển thị của shop
SHOP_NAME=Siêu Thị AI

# Username hỗ trợ (không cần @)
SUPPORT_USERNAME=sieuthiai_support

# Thông tin ngân hàng nhận tiền nạp (mã ngân hàng theo VietQR: MB, VCB, TCB, ACB, BIDV, ICB...)
BANK_ID=MB
BANK_ACCOUNT=0123456789
BANK_OWNER=NGUYEN VAN A

# Tiền tố nội dung chuyển khoản, ví dụ SAI15 -> phiếu nạp số 15
TOPUP_PREFIX=SAI

# Số tiền nạp tối thiểu (VND)
MIN_TOPUP=10000

# % hoa hồng cho người giới thiệu khi người được giới thiệu nạp tiền (0 = tắt)
REF_PERCENT=5

# Tạo sẵn danh mục/sản phẩm mẫu khi chạy lần đầu (1 = có, 0 = không)
SEED_DEMO=1

# Đường dẫn file dữ liệu SQLite
DB_PATH=data/shop.db
