+// -------------------------------------------------
+// Caro five defence
+
+namespace {
+
+/// Cells that stop the opponent's five at `fivePos`: the point itself, plus — when the five lies
+/// on a single line — the cells of that line where a defender stone leaves a non-winning
+/// (blocked) five. A five on two lines at once can only be stopped on the point itself.
+int caroFiveKillers(const Board &board, Color oppo, Pos fivePos, Pos out[])
+{
+    constexpr int H = PatternConfig::HalfLineLen<CARO>;
+    int           n = 0;
+    out[n++]        = fivePos;
+
+    int fiveDir = -1, fiveDirs = 0;
+    for (int dir = 0; dir < 4; dir++) {
+        if (board.pattern(fivePos, oppo, dir) == F5) {
+            fiveDir = dir;
+            fiveDirs++;
+        }
+    }
+    if (fiveDirs != 1)
+        return n;
+
+    uint64_t key  = board.getKeyAt<CARO>(fivePos, fiveDir);
+    uint16_t mask = PatternConfig::lookupFiveKill(key, oppo);
+    for (int i = 0; i < 2 * H; i++) {
+        if (!((mask >> i) & 0x1))
+            continue;
+        Pos pos = i < H ? fivePos - (H - i) * DIRECTION[fiveDir]
+                        : fivePos + (i - H + 1) * DIRECTION[fiveDir];
+        if (board.isEmpty(pos))
+            out[n++] = pos;
+    }
+    return n;
+}
+
+}  // namespace
+
+ScoredMove *generateCaroFiveDefence(const Board &board, ScoredMove *moveList)
+{
+    Color oppo = ~board.sideToMove();
+    assert(board.p4Count(oppo, A_FIVE) > 0);
+
+    // All opponent five-points (they are next to its stones, so inside the candidate area).
+    constexpr int MaxFives = 32;
+    Pos           fives[MaxFives];
+    int           numFives = 0;
+    FOR_EVERY_CAND_POS(&board, pos)
+    {
+        if (board.pattern4(pos, oppo) == A_FIVE && numFives < MaxFives)
+            fives[numFives++] = pos;
+    }
+    if (!numFives)
+        return moveList;
+
+    // A defence must stop every five: intersect the killer sets, starting from the first one.
+    constexpr int MaxKillers = 1 + 2 * PatternConfig::HalfLineLen<CARO>;
+    Pos           cand[MaxKillers];
+    int           numCand = caroFiveKillers(board, oppo, fives[0], cand);
+    for (int f = 1; f < numFives && numCand > 0; f++) {
+        Pos killers[MaxKillers];
+        int numKillers = caroFiveKillers(board, oppo, fives[f], killers);
+        int kept       = 0;
+        for (int c = 0; c < numCand; c++)
+            if (std::find(killers, killers + numKillers, cand[c]) != killers + numKillers)
+                cand[kept++] = cand[c];
+        numCand = kept;
+    }
+
+    for (int c = 0; c < numCand; c++)
+        *moveList++ = cand[c];
+    return moveList;
+}
+
+bool isCaroFiveDefence(const Board &board, Pos move)
+{
+    if (!board.isEmpty(move))
+        return false;
+    ScoredMove list[1 + 2 * PatternConfig::HalfLineLen<CARO>];
+    ScoredMove *end = generateCaroFiveDefence(board, list);
+    for (ScoredMove *m = list; m < end; m++)
+        if (m->pos == move)
+            return true;
+    return false;
+}
+
+ScoredMove *generateCaroFourDefence(const Board &board, ScoredMove *moveList)
+{
+    Color self = board.sideToMove(), oppo = ~self;
+    assert(board.p4Count(oppo, B_FLEX4) > 0);
+    constexpr int H = PatternConfig::HalfLineLen<CARO>;
+
+    constexpr int MaxFlex = 16;
+    Pos           flex[MaxFlex];
+    int           numFlex = 0;
+    FOR_EVERY_CAND_POS(&board, pos)
+    {
+        if (board.pattern4(pos, oppo) == B_FLEX4 && numFlex < MaxFlex)
+            flex[numFlex++] = pos;
+    }
+    if (!numFlex)
+        return moveList;
+
+    // Candidates: the first point and the empty cells of its four lines
+    Pos cand[1 + 4 * 2 * H];
+    int numCand = 0;
+    cand[numCand++] = flex[0];
+    for (int dir = 0; dir < 4; dir++) {
+        for (int k = -H; k <= H; k++) {
+            Pos pos = flex[0] + k * DIRECTION[dir];
+            if (k != 0 && board.isEmpty(pos))
+                cand[numCand++] = pos;
+        }
+    }
+
+    for (int c = 0; c < numCand; c++) {
+        Pos d = cand[c];
+        if (board.pattern4(d, self) >= E_BLOCK4)
+            continue;  // our own four: produced by the VCF generator
+        bool ok = true;
+        {
+            ScopedMove<CARO, Board::MoveType::NO_EVAL> probe(board, d);
+            for (int f = 0; f < numFlex && ok; f++)
+                ok = flex[f] == d || board.pattern4(flex[f], oppo) < B_FLEX4;
+        }
+        if (ok)
+            *moveList++ = d;
+    }
+    return moveList;
+}
