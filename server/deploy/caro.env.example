# Cấu hình máy chủ Cờ Caro – chép thành /etc/caro/caro.env (chmod 600, chủ sở hữu root).
# Sửa xong: sudo systemctl restart caro
# Danh sách đầy đủ các biến: server/README.md

# Địa chỉ công khai của trang (dùng cho ảnh xem trước khi chia sẻ link ván cờ), ví dụ https://caro.ten-mien.com
# install.sh tự điền theo tên miền
PUBLIC_URL=

# Quản trị viên duyệt câu lạc bộ / giải đấu (tên đăng nhập, cách nhau bởi dấu phẩy).
# Quyền được gắn theo ID tài khoản lúc máy chủ khởi động / lúc tài khoản đăng ký.
# LƯU Ý: tên nào chưa có tài khoản thì NGƯỜI ĐẦU TIÊN đăng ký tên đó sẽ thành quản trị —
# hãy tự đăng ký các tài khoản này TRƯỚC khi điền tên vào đây và khởi động máy chủ.
# Tài khoản quản trị không tự xoá được (muốn xoá: gỡ tên ở đây rồi khởi động lại).
ADMIN_USERNAMES=

# Tin X-Forwarded-For (chỉ khi TRUST_PROXY bật): các CIDR/IP của proxy thật, cách nhau bởi
# dấu phẩy (vd. 127.0.0.1,::1 khi proxy chạy cùng máy). Đặt biến này thì CHỈ các địa chỉ đó
# được coi là proxy — nên đặt khi cổng máy chủ có thể bị nối thẳng từ bên ngoài (vd. Docker
# công bố cổng), nếu không kẻ tấn công giả được XFF để qua mặt giới hạn theo IP (M-S2).
TRUSTED_PROXY_CIDRS=
# Origin WebSocket được phép thêm ngoài trang do chính máy chủ phục vụ, app và PUBLIC_URL —
# cách nhau bởi dấu phẩy, vd. https://marseraf7.github.io cho bản web tĩnh trên GitHub Pages (M-S1).
WS_ALLOWED_ORIGINS=

# Đăng nhập Google (bỏ trống = ẩn nút)
GOOGLE_CLIENT_ID=

# Quên mật khẩu qua email (bỏ trống = ẩn tính năng), ví dụ smtps://ten%40gmail.com:matkhau@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=

# App điện thoại cũ hơn bản này phải cập nhật mới chơi online được (bỏ trống = không kiểm tra)
MIN_APP_VERSION=
ANDROID_UPDATE_URL=
IOS_UPDATE_URL=

# Link sâu vào app (H-A5): bấm link của máy chủ này trên điện thoại thì mở thẳng app.
# Android App Links: vân tay SHA-256 của khoá ký phát hành (Play Console → Release → Setup →
# App signing → SHA-256 certificate fingerprint; nhiều vân tay cách nhau bằng dấu phẩy).
# Máy chủ tự phục vụ nó ở /.well-known/assetlinks.json. Bỏ trống = Android chưa xác minh được link.
APP_LINK_SHA256=
# iOS Universal Links: mã nhóm nhà phát triển Apple (Team ID, xem ở developer.apple.com → Membership).
# Máy chủ tự phục vụ ở /.well-known/apple-app-site-association. Bỏ trống = iOS chưa xác minh được link.
APPLE_TEAM_ID=
