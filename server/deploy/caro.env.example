# Cấu hình máy chủ Cờ Caro – chép thành /etc/caro/caro.env (chmod 600, chủ sở hữu root).
# Sửa xong: sudo systemctl restart caro
# Danh sách đầy đủ các biến: server/README.md

# Địa chỉ công khai của trang (dùng cho ảnh xem trước khi chia sẻ link ván cờ), ví dụ https://caro.ten-mien.com
# install.sh tự điền theo tên miền
PUBLIC_URL=

# Quản trị viên duyệt câu lạc bộ / giải đấu (tên đăng nhập, cách nhau bởi dấu phẩy).
# Quyền được gắn theo ID tài khoản lúc máy chủ khởi động / lúc tài khoản đăng ký.
# LƯU Ý: tên nào chưa có tài khoản thì NGƯỜI ĐẦU TIÊN đăng ký tên đó sẽ thành quản trị —
# hãy tự đăng ký các tài khoản này TRƯỚC khi điền tên vào đây và khởi động máy chủ.
# Tài khoản quản trị không tự xoá được (muốn xoá: gỡ tên ở đây rồi khởi động lại).
ADMIN_USERNAMES=

# Đăng nhập Google (bỏ trống = ẩn nút)
GOOGLE_CLIENT_ID=

# Quên mật khẩu qua email (bỏ trống = ẩn tính năng), ví dụ smtps://ten%40gmail.com:matkhau@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=

# App điện thoại cũ hơn bản này phải cập nhật mới chơi online được (bỏ trống = không kiểm tra)
MIN_APP_VERSION=
ANDROID_UPDATE_URL=
IOS_UPDATE_URL=
