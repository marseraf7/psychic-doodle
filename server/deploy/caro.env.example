# Cấu hình máy chủ Cờ Caro – chép thành /etc/caro/caro.env (chmod 600, chủ sở hữu root).
# Sửa xong: sudo systemctl restart caro
# Danh sách đầy đủ các biến: server/README.md

# Quản trị viên duyệt câu lạc bộ / giải đấu (tên đăng nhập, cách nhau bởi dấu phẩy)
ADMIN_USERNAMES=

# Đăng nhập Google (bỏ trống = ẩn nút)
GOOGLE_CLIENT_ID=

# Quên mật khẩu qua email (bỏ trống = ẩn tính năng), ví dụ smtps://ten%40gmail.com:matkhau@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=

# App điện thoại cũ hơn bản này phải cập nhật mới chơi online được (bỏ trống = không kiểm tra)
MIN_APP_VERSION=
ANDROID_UPDATE_URL=
IOS_UPDATE_URL=
