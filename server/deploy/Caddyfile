# install.sh tự cài file này. Cài tay: chép vào /etc/caddy/Caddyfile, thay tên miền, rồi: systemctl reload caddy
# Caddy tự xin / gia hạn chứng chỉ HTTPS miễn phí và tự chuyển tiếp WebSocket.
# Các header bảo mật nội dung (CSP, chống nhúng iframe, nosniff…) do máy chủ Node tự gửi.
caro.ten-mien-cua-ban.com {
	encode zstd gzip
	header {
		# includeSubDomains: chỉ phủ các tên miền con CỦA tên miền này (vd. *.caroxo.duckdns.org – cùng chủ, không dịch vụ
		# HTTP nào khác), không đụng tên miền cha / tên miền khác. KHÔNG thêm "preload": duckdns.org là tên miền dùng chung,
		# danh sách preload của trình duyệt khó gỡ ra và không dành cho tên miền con kiểu này (I-13, rà soát 20/11/2026).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Máy chủ chỉ nhận GET (file tĩnh) và WebSocket: chặn yêu cầu có thân lớn
	request_body {
		max_size 16KB
	}
	reverse_proxy 127.0.0.1:8080
	log {
		output file /var/log/caddy/caro-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
