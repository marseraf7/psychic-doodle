{
  "name": "caro-server",
  "version": "1.0.0",
  "private": true,
  "description": "Máy chủ Cờ Caro online: phòng chơi, thách đấu bạn bè, tài khoản, trạng thái online",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/tests/**' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 test/*.test.js ../caro/tests/rules.test.js ../caro/tests/study.test.js ../caro/tests/engine.test.js ../caro/tests/engine-patterns.test.js ../caro/tests/demos.test.js ../caro/tests/localclock.test.js ../caro/tests/local-games.test.js ../caro/tests/local-save.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "nodemailer": "^10.0.12",
    "ws": "^8.18.0"
  }
}
