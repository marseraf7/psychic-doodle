{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reuseforge/1.0/resume-context.schema.json",
  "title": "ReuseForge Resume Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "project_id",
    "recovered_state",
    "state_evidence_refs",
    "valid_approvals",
    "locked_decisions",
    "current_phase",
    "current_task",
    "open_questions",
    "blockers",
    "next_actor",
    "next_action",
    "confidence"
  ],
  "properties": {
    "protocol": {
      "const": "reuseforge/1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "recovered_state": {
      "enum": [
        "IDEA",
        "FRAMING",
        "FRAMED",
        "DISCOVERY",
        "DISCOVERY_COMPLETE",
        "AUDITING",
        "AUDIT_COMPLETE",
        "ARCHITECTURE_PROPOSED",
        "ARCHITECTURE_APPROVED",
        "PLANNING",
        "PLAN_READY",
        "EXECUTION_APPROVAL_REQUIRED",
        "EXECUTION_APPROVED",
        "EXECUTING",
        "VERIFYING",
        "REPAIR_REQUIRED",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "state_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "valid_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locked_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_phase": {
      "type": "string"
    },
    "current_task": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actor": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}
