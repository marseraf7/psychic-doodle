{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reuseforge/1.0/run-manifest.schema.json",
  "title": "ReuseForge Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "run_id",
    "project_id",
    "phase_id",
    "approved_tasks",
    "execution_mode",
    "max_parallel_tasks",
    "architecture_change",
    "scope_expansion",
    "approval_invalidates_on_scope_change"
  ],
  "properties": {
    "protocol": {
      "const": "reuseforge/1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{3,}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P-[0-9]{2,}$"
    },
    "approved_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{3,}$"
      },
      "minItems": 1
    },
    "execution_mode": {
      "enum": [
        "claude-code-internal",
        "opencode-internal",
        "codex",
        "external-harness"
      ]
    },
    "max_parallel_tasks": {
      "type": "integer",
      "minimum": 1
    },
    "architecture_change": {
      "const": "forbidden"
    },
    "scope_expansion": {
      "const": "forbidden"
    },
    "approval_invalidates_on_scope_change": {
      "const": true
    }
  }
}
