<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  H-A5: Universal Links — bấm link https của máy chủ game thì mở thẳng vào app.
  Cần máy chủ phục vụ /.well-known/apple-app-site-association (đã có trong server)
  kèm mã nhóm nhà phát triển qua biến môi trường APPLE_TEAM_ID.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:caroxo.duckdns.org</string>
	</array>
</dict>
</plist>
